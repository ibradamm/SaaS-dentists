{
  "name": "@dental/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:api": "tsx watch --env-file-if-exists=../../.env src/main-api.ts",
    "dev:worker": "tsx watch --env-file-if-exists=../../.env src/main-worker.ts",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "db:bootstrap": "tsx --env-file-if-exists=../../.env src/db/cli/bootstrap.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/cli/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env src/db/cli/seed.ts",
    "admin:create-clinic": "tsx --env-file-if-exists=../../.env src/db/cli/create-clinic.ts",
    "admin:create-admin": "tsx --env-file-if-exists=../../.env src/db/cli/create-admin.ts",
    "admin:reset-mfa": "tsx --env-file-if-exists=../../.env src/db/cli/reset-mfa.ts",
    "admin:clinic-lifecycle": "tsx --env-file-if-exists=../../.env src/db/cli/clinic-lifecycle.ts",
    "admin:export-clinic": "tsx --env-file-if-exists=../../.env src/db/cli/export-clinic.ts",
    "admin:purge-clinic": "tsx --env-file-if-exists=../../.env src/db/cli/purge-clinic.ts",
    "admin:retention-report": "tsx --env-file-if-exists=../../.env src/db/cli/retention-report.ts",
    "sentry:check": "tsx --env-file-if-exists=../../.env src/cli/sentry-check.ts"
  },
  "dependencies": {
    "@dental/shared": "workspace:*",
    "@fastify/cookie": "11.1.2",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@node-rs/argon2": "2.2.1",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5",
    "libphonenumber-js": "1.13.14",
    "luxon": "3.7.2",
    "otplib": "13.5.0",
    "pg": "8.23.0",
    "pg-boss": "12.35.0",
    "pino": "10.3.1",
    "uuid": "14.0.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/luxon": "3.7.1",
    "@types/node": "22.20.4",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "vitest": "5.0.2"
  }
}
