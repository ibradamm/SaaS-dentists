# Copier en .env pour le développement local. Ne jamais committer .env.
# Aucune valeur réelle ici : uniquement des valeurs de développement local.

# development | test | staging | production
APP_ENV=development
LOG_LEVEL=info

# --- Base de données -------------------------------------------------------
# Rôle applicatif (API et worker) : ni superutilisateur, ni propriétaire des tables.
DATABASE_URL=postgres://dental_app:dev-app-password-change-me@127.0.0.1:5432/dental
DATABASE_POOL_MAX=10
# Rôle propriétaire : migrations et opérations d'administration uniquement.
DATABASE_MIGRATION_URL=postgres://dental_owner:dev-owner-password-change-me@127.0.0.1:5432/dental

# Bootstrap (une seule fois, compte administrateur PostgreSQL) : crée rôles et base.
DATABASE_ADMIN_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres
DATABASE_NAME=dental
DATABASE_OWNER_PASSWORD=dev-owner-password-change-me
DATABASE_APP_PASSWORD=dev-app-password-change-me

# --- API -------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=3000
# Nombre de proxys de confiance devant l'API (1 derrière Caddy en production).
API_TRUST_PROXY_HOPS=0

# --- Tests -----------------------------------------------------------------
# Compte administrateur utilisé par les tests pour créer une base jetable à chaque exécution.
TEST_DATABASE_ADMIN_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres

# --- Phases suivantes (non utilisées pour l'instant) ------------------------
# ANTHROPIC_API_KEY=            (Phase 7)
# WHATSAPP_ACCESS_TOKEN=        (Phase 6)
# WHATSAPP_APP_SECRET=          (Phase 6)
# GOOGLE_SERVICE_ACCOUNT_JSON=  (Phase 5)
