# Copier en .env pour le développement local. Ne jamais committer .env.
# Aucune valeur réelle ici : uniquement des valeurs de développement local.

# development | test | staging | production
APP_ENV=development
LOG_LEVEL=info

# --- Base de données -------------------------------------------------------
# Rôle applicatif (API et worker) : ni superutilisateur, ni propriétaire des tables.
DATABASE_URL=postgres://dental_app:dev-app-password-change-me@127.0.0.1:5432/dental
DATABASE_POOL_MAX=10
# Rôle propriétaire : migrations et opérations d'administration uniquement.
DATABASE_MIGRATION_URL=postgres://dental_owner:dev-owner-password-change-me@127.0.0.1:5432/dental

# Bootstrap (une seule fois, compte administrateur PostgreSQL) : crée rôles et base.
DATABASE_ADMIN_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres
DATABASE_NAME=dental
DATABASE_OWNER_PASSWORD=dev-owner-password-change-me
DATABASE_APP_PASSWORD=dev-app-password-change-me

# --- API -------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=3000
# Nombre de proxys de confiance devant l'API (1 derrière Caddy en production). Obligatoire en
# staging et production : l'API refuse de démarrer sans (vérifier ensuite avec check:deployment
# --rate-limit que la limitation résiste à un X-Forwarded-For usurpé).
API_TRUST_PROXY_HOPS=0
# Origine de l'interface web (obligatoire et en HTTPS en staging/production).
WEB_ORIGIN=http://127.0.0.1:5173
# Clé de chiffrement des secrets TOTP (32 octets en base64). Laissée vide ici :
# « pnpm setup:env » en génère une dans .env. En production : gestionnaire de secrets.
# Perdre cette clé rend illisibles les secrets TOTP (réinitialisation de la double
# authentification de tous les comptes).
DATA_ENCRYPTION_KEY=

# --- Remontée des erreurs (facultative) ---------------------------------------
# DSN Sentry du projet (HTTPS obligatoire en staging et production). Vide : désactivée.
# L'environnement Sentry est APP_ENV. Aucune donnée saisie n'est envoyée (docs/adr/0011).
SENTRY_DSN=
# Version déployée (ex. identifiant de commit), pour regrouper les erreurs par version.
SENTRY_RELEASE=

# --- Conservation (worker) ----------------------------------------------------
# Sessions terminées conservées N jours puis supprimées (30 par défaut, 30 minimum :
# plancher de la politique RLS). À revoir après avis juridique (docs/adr/0011).
SESSION_RETENTION_DAYS=30

# --- Revue de conservation (commande retention-report) ------------------------
# Durées en jours, facultatives : elles mesurent ce qui les dépasse et ne suppriment RIEN
# (durées non validées juridiquement, docs/conformite/tableau-de-conservation.md).
# RETENTION_REVIEW_PATIENT_INACTIVE_DAYS=
# RETENTION_REVIEW_BILLING_DAYS=
# RETENTION_REVIEW_AUDIT_LOG_DAYS=
# RETENTION_REVIEW_IMPORT_ROWS_DAYS=

# --- Tests -----------------------------------------------------------------
# Compte administrateur utilisé par les tests pour créer une base jetable à chaque exécution.
TEST_DATABASE_ADMIN_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres

