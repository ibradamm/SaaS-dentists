# Site de l'application, importé par le Caddyfile de chaque environnement :
#   - /api/* relayé vers l'API (même origine : cookies et CSRF inchangés) ;
#   - le reste : fichiers de l'interface compilée, avec les en-têtes de sécurité générés depuis
#     apps/web/security-headers.ts (security-headers.caddy, produit au build de l'image).
# Aucun journal d'accès : les adresses contiennent des recherches de patients (?q=…).

encode zstd gzip

handle /api/* {
	reverse_proxy {$API_UPSTREAM} {
		# Une seule adresse, calculée par Caddy à partir des proxys de confiance (Caddyfile) :
		# un X-Forwarded-For fourni par le client n'atteint jamais l'API
		# (API_TRUST_PROXY_HOPS=1).
		header_up X-Forwarded-For {client_ip}
	}
}

handle {
	import security-headers.caddy
	root * {$WEB_ROOT:/srv}
	# Fichiers du build nommés par leur empreinte : cache long. index.html : toujours revalidé,
	# sinon un navigateur garderait après un déploiement une page qui cite des fichiers disparus.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	header ?Cache-Control "no-cache"
	try_files {path} /index.html
	file_server
}
